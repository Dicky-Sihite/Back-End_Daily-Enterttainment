  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Register New User",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"testuser_{{$timestamp}}\",\n  \"email\": \"testuser{{$timestamp}}@example.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/register",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "register"
              ]
            },
            "description": "Register a new user with username, email, and password"
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// Test: Status code is 201",
                  "pm.test(\"Status code is 201 Created\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "// Test: Response has success flag",
                  "pm.test(\"Response has success flag\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.success).to.be.true;",
                  "});",
                  "",
                  "// Test: Response contains user data",
                  "pm.test(\"Response contains user object\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.data).to.have.property('id');",
                  "    pm.expect(jsonData.data).to.have.property('username');",
                  "    pm.expect(jsonData.data).to.have.property('email');",
                  "});",
                  "",
                  "// Store credentials for login",
                  "if (pm.response.code === 201) {",
                  "    var jsonData = pm.response.json();",
                  "    var email = jsonData.data.email;",
                  "    pm.collectionVariables.set('user_id', jsonData.data.id);",
                  "    pm.collectionVariables.set('test_email', email);",
                  "    pm.collectionVariables.set('test_password', 'password123');",
                  "    console.log('Registered email: ' + email);",
                  "    console.log('Stored as test_email: ' + pm.collectionVariables.get('test_email'));",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Login User",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{test_email}}\",\n  \"password\": \"{{test_password}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "login"
              ]
            },
            "description": "Login with email and password"
          },
          "response": [],
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "var testEmail = pm.collectionVariables.get('test_email');",
                  "var testPassword = pm.collectionVariables.get('test_password');",
                  "console.log('Login - Using email: ' + testEmail);",
                  "console.log('Login - Using password: ' + testPassword);",
                  "if (!testEmail || testEmail === '') {",
                  "    console.log('WARNING: test_email is empty!');",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// Debug: Log the response",
                  "console.log('Login Response Status: ' + pm.response.code);",
                  "if (pm.response.code !== 200) {",
                  "    console.log('Login failed with email: ' + pm.collectionVariables.get('test_email'));",
                  "    var errorData = pm.response.json();",
                  "    console.log('Error message: ' + errorData.message);",
                  "}",
                  "",
                  "// Test: Status code is 200",
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "// Test: Response has success flag",
                  "pm.test(\"Response has success flag\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.success).to.be.true;",
                  "});",
                  "",
                  "// Test: Response contains access token",
                  "pm.test(\"Response contains access token\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.data).to.have.property('accessToken');",
                  "    pm.expect(jsonData.data.accessToken).to.not.be.empty;",
                  "});",
                  "",
                  "// Test: Response contains user data",
                  "pm.test(\"Response contains user data\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.data.user).to.have.property('id');",
                  "    pm.expect(jsonData.data.user).to.have.property('email');",
                  "});",
                  "",
                  "// Store tokens for later use",
                  "var jsonData = pm.response.json();",
                  "pm.collectionVariables.set('access_token', jsonData.data.accessToken);",
                  "pm.collectionVariables.set('user_id', jsonData.data.user.id);",
                  "",
                  "// Extract and store refresh token from cookies",
                  "var cookies = pm.cookies.jar().cookies;",
                  "cookies.forEach(function(cookie) {",
                  "    if (cookie.name === 'refreshToken') {",
                  "        pm.collectionVariables.set('refresh_token', cookie.value);",
                  "    }",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "[DEBUG] Login with Hardcoded Test Credentials",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"testuser@gmail.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "login"
              ]
            },
            "description": "DEBUGGING: Try login with hardcoded credentials to test if backend is working. If this works, then the issue is with dynamic email storage. If this also fails with 401, backend login might be broken."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "console.log('=== DEBUG LOGIN TEST ===');",
                  "console.log('Status: ' + pm.response.code);",
                  "console.log('Response: ' + pm.response.text());",
                  "",
                  "pm.test(\"[DEBUG] Hardcoded Login Test - Check console for details\", function () {",
                  "    if (pm.response.code === 200) {",
                  "        var jsonData = pm.response.json();",
                  "        pm.collectionVariables.set('access_token', jsonData.data.accessToken);",
                  "        console.log('✓ Hardcoded login SUCCESS - Backend login is working!');",
                  "        console.log('Problem is: test_email variable not being stored properly from Register');",
                  "    } else if (pm.response.code === 401) {",
                  "        console.log('✗ Hardcoded login FAILED (401) - Backend login might be broken');",
                  "        console.log('Check: Does user testuser@gmail.com exist in database?');",
                  "    } else {",
                  "        console.log('? Unexpected status code: ' + pm.response.code);",
                  "    }",
                  "});"
                ]
              }
            }
          ]
        },
